# LA COSECHA - PLANTILLA DE CONFIGURACIÓN
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Base de datos MySQL
# Base nueva y exclusiva. No importar el dump completo de la versión anterior.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=la_cosecha_soa
DB_USER=la_cosecha_app
DB_PASSWORD=

# Autenticación
# npm run configure genera estas claves cuando crea un archivo .env nuevo.
JWT_SECRET=
JWT_ISSUER=la-cosecha
SERVICE_KEY=

# Microservicios
AUTH_URL=http://127.0.0.1:4001
INVENTORY_URL=http://127.0.0.1:4002
COMMERCE_URL=http://127.0.0.1:4003
OPERATIONS_URL=http://127.0.0.1:4004
RETURNS_URL=http://127.0.0.1:4005
PACKAGING_URL=http://127.0.0.1:4006
REVIEWS_URL=http://127.0.0.1:4007
REPORTS_URL=http://127.0.0.1:4008
ORDERS_URL=http://127.0.0.1:4009
HISTORY_URL=http://127.0.0.1:4010
SHIPPING_URL=http://127.0.0.1:4011
ROLES_URL=http://127.0.0.1:4012
ALERTS_URL=http://127.0.0.1:4013

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost

# Correo electrónico
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Pagos
# Activar en .env después de configurar Stripe y su webhook.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Entorno de ejecución
# Vacío: el arranque utiliza el Python de la carpeta .venv.
PYTHON_EXECUTABLE=

# Vacío: utiliza el comando dotnet disponible en el sistema.
DOTNET_EXECUTABLE=
